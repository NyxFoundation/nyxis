import JoseLibcrypto
import Nyxis.Internal.SupabaseJwt

/-! Adoption check for the approved JWT libraries, not the HTTP/Supabase integration test.
Keys are generated by OpenSSL in the script's temporary directory and never used by the app.
Every signature operation explicitly uses Backend.libcrypto; Backend.pure is never selected.
-/
open Jose

private def checked {α : Type} (result : Except Jose.Error α) : IO α :=
  match result with
  | .ok value => pure value
  | .error reason => throw <| IO.userError s!"unexpected refusal: {reason}"

private def policy : Policy :=
  { algs := #[.es256], issuer := "https://test.supabase.co/auth/v1",
    audience := #["authenticated"], leeway := 0 }

private def now : Std.Time.Timestamp :=
  Std.Time.Timestamp.ofSecondsSinceUnixEpoch (Std.Time.Second.Offset.ofInt 1000)

private def coreChecks (jwksText : String) (key : Backend.libcrypto.PreparedKey)
    (tokens : List String) : IO Unit := do
  let some verifier ← Nyxis.Internal.SupabaseJwt.prepare policy.issuer jwksText
    | throw <| IO.userError "core refused valid public JWKS"
  let valid ← checked (← Jws.token Backend.libcrypto .es256 key headerForTest
    (bodyForTest "test-user"))
  unless (← verifier.verifyAt valid now) == some "test-user" do
    throw <| IO.userError "core refused valid subject"
  for token in tokens do
    unless (← verifier.verifyAt token now) == none do
      throw <| IO.userError "core accepted invalid token"
  for subject in ["", " ", "\x00"] do
    let token ← checked (← Jws.token Backend.libcrypto .es256 key headerForTest
      (bodyForTest subject))
    unless (← verifier.verifyAt token now) == none do
      throw <| IO.userError "core accepted invalid subject"
  for (issuer, document) in [
      ("", jwksText), (" ", jwksText), ("bad\x00issuer", jwksText),
      (policy.issuer, "not json"), (policy.issuer, "{}"),
      (policy.issuer, "{\"keys\":[]}"),
      (policy.issuer, "{\"keys\":[{\"kty\":\"unknown\"}]}")] do
    if (← Nyxis.Internal.SupabaseJwt.prepare issuer document).isSome then
      throw <| IO.userError "core accepted invalid configuration/JWKS"
  unless (← verifier.verify valid) == none do
    throw <| IO.userError "core real clock accepted expired fixture"
  IO.println s!"SupabaseJwt core: {tokens.length + 12} cases passed"

  -- Refresh is per verification and has no retained keys after a failed fetch.
  let document ← IO.mkRef (some jwksText)
  let fetches ← IO.mkRef (0 : Nat)
  let clocks ← IO.mkRef (0 : Nat)
  let seconds ← IO.mkRef (1000 : Int)
  let fetch := do
    fetches.modify (· + 1)
    document.get
  let clock := do
    clocks.modify (· + 1)
    pure (Std.Time.Timestamp.ofSecondsSinceUnixEpoch (.ofInt (← seconds.get)))
  let fresh := Nyxis.Internal.SupabaseJwt.verifyFreshWithClock policy.issuer fetch clock
  unless (← fresh valid) == some "test-user" && (← fresh valid) == some "test-user" &&
      (← fetches.get) == 2 && (← clocks.get) == 2 do
    throw <| IO.userError "refresh cached keys or clock"
  for value in [none, some "not json", some "{\"keys\":[]}",
      some (jwksText.replace "test" "rotated")] do
    document.set value
    unless (← fresh valid) == none do
      throw <| IO.userError "refresh used stale keys"
  document.set (some jwksText)
  unless (← fresh valid) == some "test-user" do
    throw <| IO.userError "refresh did not recover"
  unless (← Nyxis.Internal.SupabaseJwt.verifyFreshWithClock policy.issuer
      (throw (IO.userError "secret fetch failure")) clock valid) == none do
    throw <| IO.userError "fetch exception escaped"
  let beforeFetches ← fetches.get
  unless (← Nyxis.Internal.SupabaseJwt.verifyFreshWithClock "" fetch clock valid) == none &&
      (← fetches.get) == beforeFetches do
    throw <| IO.userError "invalid issuer reached transport"
  let beforeClocks ← clocks.get
  document.set none
  unless (← fresh valid) == none && (← clocks.get) == beforeClocks do
    throw <| IO.userError "fetch failure reached clock"
  -- Fetching can take time: read the clock afterwards, at the expiry boundary.
  unless (← Nyxis.Internal.SupabaseJwt.verifyFreshWithClock policy.issuer
      (do seconds.set 1001; pure (some jwksText)) clock valid) == none do
    throw <| IO.userError "refresh used time before fetching"
  unless (← Nyxis.Internal.SupabaseJwt.verifyFreshWithClock policy.issuer
      (pure (some jwksText)) (throw (IO.userError "secret clock failure")) valid) == none do
    throw <| IO.userError "refresh clock exception escaped"
  unless (← Nyxis.Internal.SupabaseJwt.verifyFresh policy.issuer
      (pure (some jwksText)) valid) == none do
    throw <| IO.userError "refresh real clock accepted expired token"
  IO.println "SupabaseJwt refresh: 13 cases passed (injected transport, OpenSSL, no stale fallback)"

where
  headerForTest := "{\"alg\":\"ES256\",\"kid\":\"test\",\"typ\":\"JWT\"}"
  bodyForTest (subject : String) := Lean.Json.compress <| Lean.Json.mkObj [
    ("iss", .str "https://test.supabase.co/auth/v1"),
    ("aud", .str "authenticated"), ("sub", .str subject), ("exp", Lean.toJson (1001 : Nat))]

private def payload (issuer : String := policy.issuer) (expiry : Int := 1001)
    (audience : String := "authenticated") : String :=
  "{\"iss\":\"" ++ issuer ++ "\",\"aud\":\"" ++ audience ++
    "\",\"sub\":\"test-user\",\"exp\":" ++ toString expiry ++ "}"

private def header : String := "{\"alg\":\"ES256\",\"kid\":\"test\",\"typ\":\"JWT\"}"

private def sign (key : Backend.libcrypto.PreparedKey) (body : String) : IO String := do
  checked (← Jws.token Backend.libcrypto .es256 key header body)

private def rejects (keys : KeySet Backend.libcrypto) (name token : String)
    (expected : Jose.Error) : IO Unit := do
  match ← Jwt.verify Backend.libcrypto policy keys token now with
  | .ok _ => throw <| IO.userError s!"{name}: token accepted"
  | .error actual =>
    unless actual == expected do
      throw <| IO.userError s!"{name}: expected {expected}, got {actual}"
    IO.println s!"{name}: rejected ({actual})"

def main (args : List String) : IO Unit := do
  let dir ← match args with
    | [dir] | [dir, _] => pure dir
    | _ => throw <| IO.userError "expected temporary fixture directory and optional test issuer"
  let jwks ← checked <| Jwks.parse {} (← IO.FS.readFile (dir ++ "/test-jwks.json"))
  let keys ← checked (← KeySet.ofJwks Backend.libcrypto jwks)
  let key ← checked (← Jose.Libcrypto.PreparedKey.ofPem
    (← IO.FS.readFile (dir ++ "/test-key.pem")))
  let token ← sign key (payload)
  let claims ← checked (← Jwt.verify Backend.libcrypto policy keys token now)
  unless claims.subject == some "test-user" do
    throw <| IO.userError "valid ES256 token returned a different subject"
  IO.println "valid ES256 JWT: subject test-user (one second before expiry)"
  let parts := token.splitOn "."
  let sig := parts.getD 2 ""
  let some raw := Leancrypto.Codec.Base64Url.decodeString sig
    | throw <| IO.userError "test signature is not base64url"
  unless raw.size == 64 do throw <| IO.userError "ES256 signature width is not 64"
  let tampered := Leancrypto.Codec.Base64Url.encodeString ⟨raw.data.modify 0 (· ^^^ 1)⟩
  let input := parts.getD 0 "" ++ "." ++ parts.getD 1 ""
  rejects keys "invalid signature" (input ++ "." ++ tampered) .signatureInvalid
  rejects keys "tampered subject" (Jws.signingInput header
    "{\"iss\":\"https://test.supabase.co/auth/v1\",\"aud\":\"authenticated\",\"sub\":\"victim\",\"exp\":1001}" ++
    "." ++ sig) .signatureInvalid
  rejects keys "expiry boundary" (← sign key (payload (expiry := 1000))) (.expired 1000 1000)
  rejects keys "expired" (← sign key (payload (expiry := 999))) (.expired 999 1000)
  rejects keys "wrong issuer" (← sign key (payload "https://other.supabase.co/auth/v1"))
    (.wrongIssuer policy.issuer "https://other.supabase.co/auth/v1")
  rejects keys "wrong audience" (← sign key (payload (audience := "other")))
    (.wrongAudience #["authenticated"] #["other"])
  let noneInput := Jws.signingInput "{\"alg\":\"none\"}" (payload)
  rejects keys "alg none, empty signature" (noneInput ++ ".") .emptySignature
  rejects keys "alg none, nonempty signature" (noneInput ++ ".AA") (.algUnknown "none")
  rejects keys "unknown kid" (Jws.signingInput "{\"alg\":\"ES256\",\"kid\":\"unknown\"}"
    (payload) ++ "." ++ sig) (.noKeyMatched (some "unknown"))
  rejects keys "missing expiry" (← sign key
    "{\"iss\":\"https://test.supabase.co/auth/v1\",\"aud\":\"authenticated\",\"sub\":\"test-user\"}")
    (.claimMissing "exp")
  IO.println "JWT adoption check: 11 cases passed (OpenSSL backend)"
  coreChecks (← IO.FS.readFile (dir ++ "/test-jwks.json")) key [
    input ++ "." ++ tampered,
    ← sign key (payload (expiry := 1000)),
    ← sign key (payload (expiry := 999)),
    ← sign key (payload "https://other.supabase.co/auth/v1"),
    ← sign key (payload (audience := "other")),
    noneInput ++ ".", noneInput ++ ".AA",
    Jws.signingInput "{\"alg\":\"ES256\",\"kid\":\"unknown\"}" (payload) ++ "." ++ sig,
    ← sign key ((payload).replace "\"exp\":1001" "\"nbf\":1001"),
    ← sign key ((payload).replace "\"sub\":\"test-user\"," ""),
    ← sign key ((payload).replace "\"exp\":1001" "\"exp\":1001,\"nbf\":1001"),
    "not-a-jwt"]

  -- Only temporary fixture tokens; none are real Supabase credentials.
  for subject in ["alice", "bob", "root"] do
    let body := (payload).replace "test-user" subject
    IO.FS.writeFile (dir ++ "/" ++ subject ++ ".jwt") (← sign key body)
  for (name, value) in [
      ("bad-signature", input ++ "." ++ tampered),
      ("expired", ← sign key ((payload (expiry := 999)).replace "test-user" "alice")),
      ("expiry-boundary", ← sign key ((payload (expiry := 1000)).replace "test-user" "alice")),
      ("wrong-issuer", ← sign key ((payload "https://other.supabase.co/auth/v1").replace "test-user" "alice")),
      ("wrong-audience", ← sign key ((payload (audience := "other")).replace "test-user" "alice")),
      ("none", noneInput ++ ".AA"),
      ("missing-subject", ← sign key ((payload).replace "\"sub\":\"test-user\"," "")),
      ("empty-subject", ← sign key ((payload).replace "test-user" ""))] do
    IO.FS.writeFile (dir ++ "/" ++ name ++ ".jwt") value

  -- Actual wall-clock fixtures, signed by the same approved backend.
  let seconds := (← Std.Time.Timestamp.now).toSecondsSinceUnixEpoch.val
  for (name, expiry) in [("clock-valid", seconds + 3600), ("clock-expired", seconds - 1),
      ("clock-transition", seconds + 10)] do
    IO.FS.writeFile (dir ++ "/" ++ name ++ ".jwt")
      (← sign key ((payload (expiry := expiry)).replace "test-user" "alice"))

  -- Optional fixtures for an application launcher with a temporary HTTPS issuer (second argument).
  if let [_, issuer] := args then
    for subject in ["alice", "bob", "root"] do
      IO.FS.writeFile (dir ++ "/issuer-" ++ subject ++ ".jwt")
        (← sign key ((payload issuer (seconds + 3600)).replace "test-user" subject))
    let valid ← sign key ((payload issuer (seconds + 3600)).replace "test-user" "root")
    let parts := valid.splitOn "."
    let some bytes := Leancrypto.Codec.Base64Url.decodeString (parts.getD 2 "")
      | throw <| IO.userError "invalid test signature"
    let bad := Leancrypto.Codec.Base64Url.encodeString ⟨bytes.data.modify 0 (· ^^^ 1)⟩
    for (name, value) in [
        ("bad-signature", parts.getD 0 "" ++ "." ++ parts.getD 1 "" ++ "." ++ bad),
        ("expired", ← sign key ((payload issuer (seconds - 1)).replace "test-user" "root")),
        ("wrong-issuer", ← sign key ((payload "https://other.supabase.co/auth/v1"
          (seconds + 3600)).replace "test-user" "root"))] do
      IO.FS.writeFile (dir ++ "/issuer-" ++ name ++ ".jwt") value
