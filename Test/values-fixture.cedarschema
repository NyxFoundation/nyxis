// A schema for the core tests; not an application file. It has datetime / decimal extension values, Set<entity> /
// Set<String>, and record-typed attributes as columns, and Doc has its owner (the parent column owner) as its parent
// (judged by `resource in principal` in the policy).

entity User = {
  "admin": Bool
};

@parents("owner")
entity Doc in [User] = {
  "owner": User,
  "viewers": Set<User>,
  "labels": Set<String>,
  "created": datetime,
  "expires": datetime,
  "price": decimal,
  "meta": { "editor": User, "pinned": Bool, "note"?: String }
};

entity Anonymous;

@effect("insert User")
action "registerUser" appliesTo {
  principal: [User],
  resource: [User],
  context: { "values": { "admin": Bool } }
};

@effect("read Doc")
action "readDoc" appliesTo {
  principal: [User, Anonymous],
  resource: [Doc]
};

@effect("list Doc")
action "listDocs" appliesTo {
  principal: [User, Anonymous],
  resource: [Doc]
};

@effect("insert Doc")
action "createDoc" appliesTo {
  principal: [User],
  resource: [Doc],
  context: { "values": {
    "owner": User, "viewers": Set<User>, "labels": Set<String>, "created": datetime,
    "expires": datetime, "price": decimal,
    "meta": { "editor": User, "pinned": Bool, "note"?: String } } }
};

@effect("update Doc(viewers, labels, expires, price, meta)")
action "editDoc" appliesTo {
  principal: [User],
  resource: [Doc],
  context: { "values": {
    "viewers"?: Set<User>, "labels"?: Set<String>, "expires"?: datetime, "price"?: decimal,
    "meta"?: { "editor": User, "pinned": Bool, "note"?: String } } }
};

@effect("delete Doc")
action "deleteDoc" appliesTo {
  principal: [User],
  resource: [Doc]
};
