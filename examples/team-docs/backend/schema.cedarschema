// 2 つめの公式サンプル(team-docs)の Cedar スキーマ。
//
// 組織(ワークスペース)に複数の利用者が owner / editor / viewer として属し、文書を組織内で共有し、
// 個別の利用者にも共有できる。文書は作成日時と更新日時を持ち、その値は nyxis が要求ごとに決める
// 現在時刻(`context.now`)でなければ記録されない(policies.cedar)。
//
// nyxis ではこの文書がテーブル定義を兼ねる:
//   - エンティティ型 = テーブル、属性 = 列、エンティティ ID = 主キー(写像のコードは無い)。
//   - 各アクションには `@effect("…")` で効果(permit されたとき DB で起きる操作)を 1 つ添える。
//   - 所属は別テーブルの行(所属行)で表す: `Membership` の行が「利用者 user が組織 org の組 team に属する」ことを
//     表し、`entity User in [Team, Org]` と `@memberships("Membership: user -> team, org")` は、利用者の実体が
//     自分の所属行の team と org の値を親(Cedar の祖先)に持つことを宣言する。ポリシーは
//     `principal in resource.org`(主体が対象の組織のメンバーなら)と `principal in resource.org.editors`
//     (主体が対象の組織の編集者の組に属するなら)と書ける。多対多の所属(1 人が複数の組織に、1 つの組織に
//     複数の人が属する)は所属行の数だけ表せる。
//   - 組(`Team`)は組織ごとの役割の組で、組織は editor の組と viewer の組を 1 つずつ参照する。owner は組織の行の
//     利用者の集合(`owners`)で持つ(所属の変更と組織の削除ができる少数の管理者)。
//   - `entity Doc in [Org]` と `@parents("org")` は、文書の実体が列 `org` の値(組織)を親に持つことを宣言する。
//   - `Set<User>` の列は実体の集合(owner の集合、個別の共有先)。
//   - 挿入・更新のアクションの `context` には提案される値 `values` が入り、`now` を宣言したアクションでは
//     nyxis の決めた現在時刻が `context.now` に入る(ハンドラは偽れない)。
//   - `@unique("列, …")` は列の組の一意性(組織名は一意、文書の題名は組織の中で一意、組の役割は組織の中で一意、
//     所属行は利用者と組の組ごとに 1 つ)。違反は 409。
//   - `@references("列 restrict, 列 cascade アクション")` は実体参照の列の参照整合: 参照先の行が無い挿入・更新は 409。
//     参照される行の削除は、`restrict` なら参照する行があれば 409(文書を作った利用者は消せない)、`cascade` なら
//     参照する行も消える(組織を消すと組・所属行・文書も消え、利用者を消すとその所属行も消える)。消える各行は
//     そのアクション(`deleteTeam` / `removeMember` / `deleteDoc`)で判定され、1 行でも permit されなければ要求全体が
//     403 になり何も消えない。nyxis は同じ制約を DB にも設定する。
//   - 添付: 文書は 1 つの添付ファイルを Supabase Storage に持てる。`@attachment("attachment")` は、添付のオブジェクトの
//     名(nyxis が発行した一意 ID)を保存する String 列を名指しする(空文字列は添付なし)。`@effect("upload Doc")` /
//     `@effect("download Doc")` は宣言された外部効果で、permit されたときだけ nyxis が Storage のオブジェクト
//     `Doc/<文書の主キー>/<名>`(アップロードでは `context.id`、ダウンロードでは列 `attachment` の値)への署名付き URL の
//     発行を求める。ハンドラはパスもバケットも名指しできず、ファイルの内容は nyxis を通らない。
//   - 通知: 利用者は文書を購読でき(`Subscription`。宛先のメールアドレスは購読時に利用者が書く列 `email`。Auth からは
//     読まない)、文書が共有されると購読者ごとに通知の行(`Notification`: 宛先・件名・本文・送信済みか)が作られて
//     メールが送られる。`@effect("mail Notification(email; subject, body)")` は宣言された外部効果で、permit されたときだけ
//     nyxis がその行の列 `email` を宛先、`subject` を件名、`body` を本文としてコア設定の SMTP 中継へ送る。ハンドラは
//     宛先も内容も名指しできない。送信は DB を変えない(送信済みの記録は別のアクション `markNotificationSent`)。
//   - `Service` は nyxis が予約するサービス主体の型(テーブルではない)。定期処理(`TeamDocs.Jobs.notifyPending`: 送信
//     済みでない通知のうち、宛先の利用者がいま文書を読めるものだけを送る)の主体で、ID はコア設定
//     `NYXIS_SERVICE_PRINCIPAL` から決まる。HTTP の要求の主体には決してならない(JWT の主体は常に `User`)。
//   - `Anonymous` は nyxis が予約する主体の型で、JWT が無い・検証に失敗したリクエストの主体。テーブルではない。
//   - 外部 API 呼び出し: `@external("base: …; auth: …")` を添えた `Summarizer` / `Audit` は名前付きの送り先
//     (nyxis が予約する仲間。テーブルではなく、属性・親を持たず、`appliesTo` にも書けない)。ベース URL と認証方式は
//     ここに書き、鍵はコア設定 `NYXIS_EXT_SUMMARIZER` / `NYXIS_EXT_AUDIT`(環境変数。正本には名前だけ)。
//     `@effect("call …")` は宣言された外部効果で、permit されたときだけ nyxis が、正本の宣言と対象の行の列だけから
//     決めた URL と本文を送る(ハンドラは URL もヘッダも本文も組めない)。`sync`(`summarizeDoc`)は応答を正本で宣言した型に
//     復号してハンドラへ値として渡し、ハンドラはそれを別のアクション(`recordSummary`)で DB に書く — その書き込みは通常の
//     判定を通る。`async`(`announceDocUpdate`)は応答なしで、nyxis の予約テーブル `_nyxis_outbox` に同じトランザクションで
//     書かれ、COMMIT の後に nyxis の内部ループが送る。このサンプルの送り先はどちらもローカルの模擬 API
//     (`scripts/check-team-docs.py` が https://localhost:18118 に立てる)で、本番の URL ではない。
//
// 開発者はこの文書と policies.cedar を読んで承認する。

// 利用者。Supabase Auth のユーザー ID がエンティティ ID(主キー)になる。所属行(Membership)の team と org を親に持つ。
@memberships("Membership: user -> team, org")
entity User in [Team, Org] = {
  "name": String
};

// 組織。owner は利用者の集合で持ち(所属の変更と組織の削除ができる)、editor と viewer はそれぞれ 1 つの組(Team)で
// 持つ(組の所属は Membership の行)。組織名は一意。
@unique("name")
entity Org = {
  "name": String,
  "owners": Set<User>,
  "editors": Team,
  "viewers": Team
};

// 組織の役割の組。役割は組織の中で一意(組織ごとに editor の組と viewer の組が 1 つずつ)。組織が消えれば組も消える。
@unique("org, role")
@references("org cascade deleteTeam")
entity Team = {
  "org": Org,
  "role": String
};

// 所属行: 利用者 user が組織 org の組 team に属する。利用者と組の組ごとに 1 行。利用者・組・組織のどれが消えても
// 所属行は消える(各行を removeMember で判定)。
@unique("user, team")
@references("user cascade removeMember, team cascade removeMember, org cascade removeMember")
entity Membership = {
  "user": User,
  "team": Team,
  "org": Org
};

// 文書。組織を親に持ち、個別の共有先(shared)を持てる。題名は組織の中で一意。組織が消えれば文書も消え(各文書を
// deleteDoc で判定)、文書を作った利用者は消せない。添付の名は列 attachment(空文字列は添付なし)。要約(summary)は
// 外部の要約 API(Summarizer)の応答を recordSummary で記録した値(空文字列は要約なし)。
@parents("org")
@unique("org, title")
@references("org cascade deleteDoc, createdBy restrict")
@attachment("attachment")
entity Doc in [Org] = {
  "org": Org,
  "title": String,
  "body": String,
  "shared": Set<User>,
  "createdBy": User,
  "createdAt": datetime,
  "updatedAt": datetime,
  "attachment": String,
  "summary": String
};

// 購読: 利用者 user が文書 doc の共有の通知を受け取る。宛先のメールアドレスは購読時に書く。利用者と文書の組ごとに 1 行。
// 文書か利用者が消えれば購読も消える(各行を deleteSubscription で判定)。
@unique("doc, user")
@references("doc cascade deleteSubscription, user cascade deleteSubscription")
entity Subscription = {
  "doc": Doc,
  "user": User,
  "email": String
};

// 通知: 文書の共有時に購読者ごとに作られる送信の記録。元の購読(subscription)を指し、宛先(email)と宛先の利用者
// (recipient)はその購読の列と一致し、件名(subject)と本文(body)は文書の題名と本文と一致することをポリシーが要求する
// (作成時と送信時)。メール送信の効果はこの行の列の値をそのまま使う。sent は送信済みか。文書・宛先の利用者・購読が消えれば
// 通知も消える。
@references("doc cascade deleteNotification, recipient cascade deleteNotification, subscription cascade deleteNotification")
entity Notification = {
  "doc": Doc,
  "recipient": User,
  "subscription": Subscription,
  "email": String,
  "subject": String,
  "body": String,
  "sent": Bool
};

// 匿名の主体(nyxis が予約。テーブルではない)。
entity Anonymous;

// サービス主体(nyxis が予約。テーブルではない)。定期処理の主体で、HTTP の要求の主体にはならない。
entity Service;

// 外部 API の送り先(nyxis が予約する仲間。テーブルではない)。文書の要約 API(sync)と、文書の更新の監査ログ API(async)。
// どちらもローカルの模擬 API(統合テストが立てる)。鍵は環境変数 NYXIS_EXT_SUMMARIZER / NYXIS_EXT_AUDIT。
@external("base: https://localhost:18118/summarizer; auth: bearer NYXIS_EXT_SUMMARIZER")
entity Summarizer;

@external("base: https://localhost:18118/audit; auth: bearer NYXIS_EXT_AUDIT")
entity Audit;

// 利用者を登録する(自分自身の User 行を作る)。
@effect("insert User")
action "registerUser" appliesTo {
  principal: [User],
  resource: [User],
  context: { "values": { "name": String } }
};

// 利用者を読む。本人だけ。
@effect("read User")
action "readUser" appliesTo {
  principal: [User],
  resource: [User]
};

// 利用者を消す(自分自身の User 行)。所属行は連鎖で消える。文書を作った利用者は参照整合(restrict)で消せない(409)。
@effect("delete User")
action "deleteUser" appliesTo {
  principal: [User],
  resource: [User]
};

// 組織を作る。作る人が唯一の owner になり、editor と viewer の組はまだ存在しない組を指す(続けて createTeam で作る)。
@effect("insert Org")
action "createOrg" appliesTo {
  principal: [User],
  resource: [Org],
  context: { "values": { "name": String, "owners": Set<User>, "editors": Team, "viewers": Team } }
};

// 組織を読む。owner と、いずれかの組に属する利用者だけ。
@effect("read Org")
action "readOrg" appliesTo {
  principal: [User],
  resource: [Org]
};

// 所属する組織の一覧。
@effect("list Org")
action "listOrgs" appliesTo {
  principal: [User],
  resource: [Org]
};

// 組織を消す。owner だけ。組・所属行・文書は cascade で消え、各文書は deleteDoc で判定される(他の人の文書が残っていれば消せない)。
@effect("delete Org")
action "deleteOrg" appliesTo {
  principal: [User],
  resource: [Org]
};

// 組織の owner の集合を変える。owner だけ。自分を外せない。
@effect("update Org(owners)")
action "setOwners" appliesTo {
  principal: [User],
  resource: [Org],
  context: { "values": { "owners"?: Set<User> } }
};

// 組織の役割の組を作る。組織の owner だけ。組織がその役割の組として参照している組に限る。
@effect("insert Team")
action "createTeam" appliesTo {
  principal: [User],
  resource: [Team],
  context: { "values": { "org": Org, "role": String } }
};

// 組を消す(組織の削除の連鎖で各組をこれで判定する)。組織の owner だけ。
@effect("delete Team")
action "deleteTeam" appliesTo {
  principal: [User],
  resource: [Team]
};

// 利用者を組織の組に加える(所属行を作る)。組織の owner だけ。組はその組織の組でなければならない。
@effect("insert Membership")
action "addMember" appliesTo {
  principal: [User],
  resource: [Membership],
  context: { "values": { "user": User, "team": Team, "org": Org } }
};

// 組織の所属行の一覧。owner と、いずれかの組に属する利用者だけ。
@effect("list Membership")
action "listMembers" appliesTo {
  principal: [User],
  resource: [Membership]
};

// 所属行を消す(組織・組・利用者の削除の連鎖でも各所属行をこれで判定する)。本人か、組織の owner。
@effect("delete Membership")
action "removeMember" appliesTo {
  principal: [User],
  resource: [Membership]
};

// 文書を作る。組織の owner と editor の組の利用者だけ。作成日時・更新日時は nyxis の現在時刻(context.now)。添付と要約は無し。
@effect("insert Doc")
action "createDoc" appliesTo {
  principal: [User],
  resource: [Doc],
  context: {
    "values": {
      "org": Org, "title": String, "body": String, "shared": Set<User>,
      "createdBy": User, "createdAt": datetime, "updatedAt": datetime, "attachment": String, "summary": String
    },
    "now": datetime
  }
};

// 文書を読む。組織の owner、組織の組に属する利用者、個別に共有された利用者。
@effect("read Doc")
action "readDoc" appliesTo {
  principal: [User],
  resource: [Doc]
};

// 文書の一覧。各行に readDoc と同じ条件を適用する。
@effect("list Doc")
action "listDocs" appliesTo {
  principal: [User],
  resource: [Doc]
};

// 文書の題名・本文を編集する。更新日時は nyxis の現在時刻でなければならない。
@effect("update Doc(title, body, updatedAt)")
action "editDoc" appliesTo {
  principal: [User],
  resource: [Doc],
  context: {
    "values": { "title"?: String, "body"?: String, "updatedAt"?: datetime },
    "now": datetime
  }
};

// 文書の要約を外部の要約 API に求める(外部効果。sync)。組織の owner と editor の組の利用者だけ。permit されると nyxis が
// Summarizer の POST /v1/summaries/<文書の主キー> に文書の題名と本文を送り、応答を { summary: String } に復号してハンドラへ
// 渡す(5 秒で期限)。応答は DB に書かれず、ハンドラが recordSummary で別に判定を通して記録する。
@effect("call Summarizer POST /v1/summaries/{key} Doc(title, body) sync 5s -> { summary: String }")
action "summarizeDoc" appliesTo {
  principal: [User],
  resource: [Doc]
};

// 要約を記録する(外部 API の応答の値を書く唯一の経路)。組織の owner と editor の組の利用者だけ。空の要約は記録できない。
@effect("update Doc(summary)")
action "recordSummary" appliesTo {
  principal: [User],
  resource: [Doc],
  context: { "values": { "summary"?: String } }
};

// 文書の更新を監査ログ API に通知する(外部効果。async)。組織の owner と editor の組の利用者だけ。permit されると nyxis が
// Audit の POST /v1/docs/<文書の主キー>/updated に文書の題名と更新日時を、要求と同じトランザクションでアウトボックスに書き、
// COMMIT の後に内部ループが送る(応答は無い)。
@effect("call Audit POST /v1/docs/{key}/updated Doc(title, updatedAt) async")
action "announceDocUpdate" appliesTo {
  principal: [User],
  resource: [Doc]
};

// 文書を個別の利用者に共有する(共有先の集合を置き換える)。組織の owner と editor の組の利用者だけ。
@effect("update Doc(shared)")
action "shareDoc" appliesTo {
  principal: [User],
  resource: [Doc],
  context: { "values": { "shared"?: Set<User> } }
};

// 文書を削除する。その文書の作成者だけ(組織の owner か editor の組に残っている間)。組織の削除の連鎖でも各文書をこれで判定する。
@effect("delete Doc")
action "deleteDoc" appliesTo {
  principal: [User],
  resource: [Doc]
};

// 添付の名を記録する(アップロード URL の発行の直前に、nyxis の発行した一意 ID を列 attachment に書く)。
// 組織の owner と editor の組の利用者だけ。記録できる名はこの要求の一意 ID(context.id)に限る。
@effect("update Doc(attachment)")
action "attachDoc" appliesTo {
  principal: [User],
  resource: [Doc],
  context: { "values": { "attachment"?: String }, "id": String }
};

// 添付の署名付きアップロード URL を発行する(外部効果)。組織の owner と editor の組の利用者で、文書に記録された
// 添付の名がこの要求の一意 ID であるときだけ(発行の対象は Doc/<文書>/<context.id>)。
@effect("upload Doc")
action "uploadAttachment" appliesTo {
  principal: [User],
  resource: [Doc],
  context: { "id": String }
};

// 添付の署名付きダウンロード URL を発行する(外部効果)。文書を読める利用者(組織の owner、組織の組に属する利用者、
// 個別に共有された利用者)。発行の対象は Doc/<文書>/<列 attachment の値>。
@effect("download Doc")
action "downloadAttachment" appliesTo {
  principal: [User],
  resource: [Doc]
};

// 文書を購読する(自分自身の購読行を作る)。文書を読める利用者だけ。宛先のメールアドレスは本文で与える。
@effect("insert Subscription")
action "subscribe" appliesTo {
  principal: [User],
  resource: [Subscription],
  context: { "values": { "doc": Doc, "user": User, "email": String } }
};

// 文書の購読の一覧。本人の購読と、文書の組織の owner・editor の組の利用者(共有時に宛先を集めるため)。
@effect("list Subscription")
action "listSubscriptions" appliesTo {
  principal: [User],
  resource: [Subscription]
};

// 購読をやめる。本人か、文書の作成者か、文書の組織の owner(文書・利用者の削除の連鎖でも各行をこれで判定する)。
@effect("delete Subscription")
action "deleteSubscription" appliesTo {
  principal: [User],
  resource: [Subscription]
};

// 通知の行を作る(文書の共有時に購読者ごとに)。文書の組織の owner と editor の組の利用者だけ。宛先と宛先の利用者は
// 指した購読の列、件名と本文は文書の題名と本文、送信済みではない行に限る(ポリシー)。
@effect("insert Notification")
action "createNotification" appliesTo {
  principal: [User],
  resource: [Notification],
  context: { "values": { "doc": Doc, "recipient": User, "subscription": Subscription, "email": String, "subject": String, "body": String, "sent": Bool } }
};

// 通知のメールを送る(外部効果)。宛先は列 email、件名は列 subject、本文は列 body。文書の組織の owner と editor の組の
// 利用者、またはサービス主体(定期処理)。送信済みでなく、宛先と宛先の利用者が指した購読の列と一致し、宛先の利用者がいま
// 文書を読めるときだけ。
@effect("mail Notification(email; subject, body)")
action "sendNotification" appliesTo {
  principal: [User, Service],
  resource: [Notification]
};

// 通知を送信済みにする。文書の組織の owner と editor の組の利用者、またはサービス主体。
@effect("update Notification(sent)")
action "markNotificationSent" appliesTo {
  principal: [User, Service],
  resource: [Notification],
  context: { "values": { "sent"?: Bool } }
};

// 通知の一覧。サービス主体(定期処理が送信済みでない通知を集める)と、文書の組織の owner・editor の組の利用者。
@effect("list Notification")
action "listNotifications" appliesTo {
  principal: [User, Service],
  resource: [Notification]
};

// 通知を消す(文書・利用者の削除の連鎖で各行をこれで判定する)。宛先の本人か、文書の作成者か、文書の組織の owner。
@effect("delete Notification")
action "deleteNotification" appliesTo {
  principal: [User],
  resource: [Notification]
};
