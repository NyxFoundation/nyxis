// Cedar schema of the sample application (bulletin board).
//
// In nyxis this document doubles as the table definitions: - entity type = table, attribute = column, entity ID =
// primary key (there is no mapping code). - Each action carries exactly one effect via `@effect("…")` (the DB operation
// that happens when it is permitted). @effect("read <Table>") read a row @effect("list <Table>") list the permitted
// rows @effect("insert <Table>") insert a row (the proposed values are the target) @effect("update <Table>(<col>,
// <col>, …)") update only the listed columns @effect("delete <Table>") delete a row nyxis rejects, at build time,
// actions without an effect and effects that reference tables or columns not in the schema.
// - `Anonymous` is a principal type reserved by nyxis; it represents `Anonymous::"anonymous"`, the principal of a
// request with no JWT or with a JWT that failed verification. It does not correspond to a table.
//
// The developer reads and approves this document and policies.cedar.

// A user. The Supabase Auth user ID is the entity ID (primary key).
entity User = {
  "admin": Bool
};

// A post.
entity Post = {
  "author": User,
  "title": String,
  "body": String,
  "published": Bool
};

// The anonymous principal (reserved by nyxis; not a table).
entity Anonymous;

// Read a post. Published posts by anyone, drafts only by their author and admins (policies.cedar).
@effect("read Post")
action "readPost" appliesTo {
  principal: [User, Anonymous],
  resource: [Post]
};

// List posts. The same policy conditions as readPost apply to each row.
@effect("list Post")
action "listPosts" appliesTo {
  principal: [User, Anonymous],
  resource: [Post]
};

// Create a post. The proposed row (author, title, body, published) is the target.
@effect("insert Post")
action "createPost" appliesTo {
  principal: [User],
  resource: [Post]
};

// Edit a post's title and body.
@effect("update Post(title, body)")
action "editPost" appliesTo {
  principal: [User],
  resource: [Post]
};

// Publish a post (or return it to draft).
@effect("update Post(published)")
action "publishPost" appliesTo {
  principal: [User],
  resource: [Post]
};

// Delete a post.
@effect("delete Post")
action "deletePost" appliesTo {
  principal: [User],
  resource: [Post]
};

// Grant or revoke admin rights (rewrites the user's admin column).
@effect("update User(admin)")
action "setAdmin" appliesTo {
  principal: [User],
  resource: [User]
};

// Register a user (creates your own User row with admin=false). The proposed values are context.values.
@effect("insert User")
action "registerUser" appliesTo {
  principal: [User],
  resource: [User],
  context: { "values": { "admin": Bool } }
};

// Read a user. Only the user themselves and admins (policies.cedar).
@effect("read User")
action "readUser" appliesTo {
  principal: [User],
  resource: [User]
};
