{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Nyxis 公式サンプル(掲示板)フロントエンドのデザイントークン。紙(地)と墨(文字・罫・ボタン)に、朱(印・管理者)と緑(できた・公開中)。実装では CSS 変数(--color-paper など)に写す。ダークは任意。",
  "color": {
    "light": {
      "paper": { "$value": "#F2F1EC", "$description": "ページの地。黄みの無い灰がかった生成り" },
      "sheet": { "$value": "#FFFFFF", "$description": "投稿の紙・フォームの紙" },
      "ink": { "$value": "#17181A", "$description": "文字・罫・主要ボタン・人物マーク" },
      "ink-2": { "$value": "#4A4D52", "$description": "本文の抜粋・控えめなボタンの文字" },
      "ink-3": { "$value": "#6E7177", "$description": "番号・ID・小見出し・メニューの非選択。地で 4.9:1" },
      "rule": { "$value": "#D6D4CC", "$description": "細い罫" },
      "rule-strong": { "$value": "#17181A", "$description": "太い罫(3px)。ヘッダの下、紙の上辺" },
      "silhouette": { "$value": "#E6E4DD", "$description": "読めない本文のシルエット・読み込み中" },
      "placeholder": { "$value": "#B3B5B8" },
      "vermilion": { "$value": "#C8311F", "$description": "朱。見られません/できませんの印、削除、管理者、ワードマークの四角。白地で 5.6:1" },
      "green": { "$value": "#1F7A3E", "$description": "緑。公開中タグ、できた印、できることの○。白地で 5.3:1" },
      "blue": { "$value": "#2851A3", "$description": "青。「あなた」タグ。白地で 7.5:1" },
      "amber": { "$value": "#B7791F", "$description": "黄。入力をたしかめる下線、利用登録まだの輪郭" },
      "amber-text": { "$value": "#8A5A12", "$description": "黄の下の一文。薄黄の地で 5.5:1" },
      "amber-tint": { "$value": "#FBF0D9", "$description": "入力をたしかめる欄の地" },
      "toast-ok": { "$value": "#5BD08A", "$description": "黒い通知の中のチェック" }
    },
    "dark": {
      "paper": { "$value": "#121311" },
      "sheet": { "$value": "#1C1D1A" },
      "ink": { "$value": "#F2F1EC" },
      "ink-2": { "$value": "#C9C8C2" },
      "ink-3": { "$value": "#9A9C9F" },
      "rule": { "$value": "#34362F" },
      "rule-strong": { "$value": "#F2F1EC" },
      "silhouette": { "$value": "#2A2B27" },
      "placeholder": { "$value": "#6E7177" },
      "vermilion": { "$value": "#E8553F" },
      "green": { "$value": "#4FBF72" },
      "blue": { "$value": "#7FA3F0" },
      "amber": { "$value": "#E0A33E" },
      "amber-text": { "$value": "#F0C875" },
      "amber-tint": { "$value": "#3A2E12" },
      "toast-ok": { "$value": "#5BD08A" }
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "\"Zen Kaku Gothic New\", \"Hiragino Sans\", system-ui, sans-serif", "$description": "すべての日本語と UI。next/font で自己ホストする" },
      "mono": { "$value": "\"DM Mono\", ui-monospace, Menlo, monospace", "$description": "ID、番号、「くわしく」の中身だけ" }
    },
    "size": {
      "xs": { "$value": "12px", "$description": "タグ、小見出し(字間 .1em)、ID 行" },
      "sm": { "$value": "13px", "$description": "番号、黄の一文、くわしく" },
      "md": { "$value": "14px", "$description": "本文の抜粋、人物マークの文字、控えめなボタン" },
      "base": { "$value": "16px", "$description": "本文、ボタン、入力" },
      "lg": { "$value": "20px", "$description": "一覧の題名、印の下の一文" },
      "xl": { "$value": "28px", "$description": "投稿/編集の題名入力、印" },
      "2xl": { "$value": "34px", "$description": "画面の見出し" }
    },
    "weight": {
      "regular": { "$value": 400 },
      "medium": { "$value": 500, "$description": "控えめなボタン" },
      "bold": { "$value": 700, "$description": "題名、タグ、ボタン、メニュー" },
      "black": { "$value": 900, "$description": "見出し、ワードマーク、印、題名入力" }
    },
    "lineHeight": {
      "body": { "$value": 1.7 },
      "reading": { "$value": 1.9, "$description": "投稿本文" },
      "heading": { "$value": 1.2 },
      "tight": { "$value": 1 }
    },
    "letterSpacing": {
      "heading": { "$value": "0.02em" },
      "wordmark": { "$value": "0.04em" },
      "label": { "$value": "0.1em", "$description": "小見出し・タグ" },
      "stamp": { "$value": "0.18em" }
    }
  },
  "spacing": {
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px", "$description": "本文の左右の余白(全幅)" },
    "6": { "$value": "24px" },
    "7": { "$value": "28px", "$description": "紙の内側(上下)" },
    "8": { "$value": "32px", "$description": "紙の内側(左右)、見出しの下" },
    "9": { "$value": "36px" },
    "12": { "$value": "56px", "$description": "本文の下の余白" }
  },
  "radius": {
    "none": { "$value": "0", "$description": "入力(下線だけ)" },
    "xs": { "$value": "2px", "$description": "タグ、シルエット、ワードマークの四角" },
    "sm": { "$value": "4px", "$description": "ボタン、黒い帯、破線の枠、朱の枠" },
    "md": { "$value": "6px", "$description": "印" },
    "full": { "$value": "999px", "$description": "人物マーク、進み具合の丸" }
  },
  "border": {
    "rule": { "$value": "1px solid {color.light.rule}" },
    "rule-strong": { "$value": "3px solid {color.light.ink}", "$description": "ヘッダの下、紙の上辺、メニューの選択中" },
    "control": { "$value": "1.5px solid {color.light.ink}", "$description": "ボタン、切替、入力の下線" },
    "tag": { "$value": "1.5px solid currentColor", "$description": "下書きは dashed" },
    "stamp": { "$value": "3px solid {color.light.vermilion}", "$description": "内側に 3px の白と 1px の同色で二重線(box-shadow inset)" },
    "empty": { "$value": "1.5px dashed #9A9C9F", "$description": "見つかりません" }
  },
  "stamp": {
    "rotate": { "$value": "-7deg" },
    "rotate-sm": { "$value": "-5deg" },
    "double-line": { "$value": "inset 0 0 0 3px {color.light.sheet}, inset 0 0 0 4px currentColor" },
    "background": { "$value": "rgba(255, 255, 255, 0.9)" }
  },
  "size": {
    "touch": { "$value": "44px", "$description": "ボタン・メニュー・入力の最小高さ" },
    "touch-sm": { "$value": "36px", "$description": "控えめなボタン(ログアウト・コピー・やめる)" },
    "avatar": { "$value": "32px" },
    "avatar-lg": { "$value": "56px" },
    "avatar-xl": { "$value": "64px" },
    "tag": { "$value": "22px" },
    "icon": { "$value": "18px" },
    "content-max": { "$value": "760px", "$description": "本文の最大幅(1 カラム)" },
    "list-number": { "$value": "44px", "$description": "一覧の番号の列" }
  },
  "breakpoint": {
    "phone": { "$value": "390px", "$description": "確認する最小幅" },
    "stack": { "$value": "640px", "$description": "これ未満でヘッダを 2 段に、ボタン列を縦に積む、できることを 2 列に" },
    "desktop": { "$value": "1280px", "$description": "模型の幅" }
  },
  "motion": {
    "stamp-in": { "$value": "180ms cubic-bezier(.2,.9,.3,1.4)", "$description": "印が少し大きい状態から押される。prefers-reduced-motion では 0" },
    "stamp-ok-out": { "$value": "2000ms", "$description": "緑の印が消えるまで" },
    "toast": { "$value": "3000ms" },
    "transition": { "$value": "120ms ease-out" }
  },
  "zIndex": {
    "header": { "$value": 10 },
    "band": { "$value": 20 },
    "toast": { "$value": 30 }
  }
}
